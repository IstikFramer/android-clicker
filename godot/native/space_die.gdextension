[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://native/bin/linux/debug/libspace_die_ext.so"
linux.release.x86_64 = "res://native/bin/linux/release/libspace_die_ext.so"
windows.debug.x86_64 = "res://native/bin/windows/debug/space_die_ext.dll"
windows.release.x86_64 = "res://native/bin/windows/release/space_die_ext.dll"
