config_version=5

[application]
config/name="SPACE DIE"
config/version="0.1.0"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.02,0.027,0.045,1)
boot_splash/show_image=false

[autoload]
EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
Settings="*res://scripts/autoload/settings.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]
theme/custom="res://assets/ui/console_theme.tres"

[internationalization]
locale/fallback="ru"
locale/translations=PackedStringArray("res://i18n/strings.ru.translation", "res://i18n/strings.en.translation")

[physics]
3d/physics_engine="Jolt Physics"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.016,0.026,0.041,1)

[input]
select={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
fire={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventMouseButton,"button_index":1)]
}
orbit_drag={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
reset={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
skip_cinematic={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194309)]
}
mute={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}
